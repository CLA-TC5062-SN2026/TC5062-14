# ─── Copia este archivo como .env y ajusta los valores ───
# cp .env.example .env
# El archivo .env NO se versiona (está en .gitignore).

# Servidor
HOST=127.0.0.1
PORT=5000
# 1 activa el depurador de Werkzeug (solo en tu máquina, nunca en red ni producción)
FLASK_DEBUG=0

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=uncalificado
DB_PASSWORD=
DB_NAME=uncalificado

# JWT
# Secreto para firmar los tokens (HS256). OBLIGATORIO: la API no arranca si está vacío,
# tiene menos de 32 caracteres o es un valor de ejemplo. Genéralo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Vigencia del token de acceso. Acepta segundos (900) o sufijos s/m/h/d (15m, 1h).
# El contrato fija 15 minutos (RNF-11). Máximo permitido: 24h.
JWT_EXPIRATION=15m

# bcrypt: factor de costo (12 en producción; se puede bajar a 4 solo en pruebas)
BCRYPT_ROUNDS=12
