@startuml
title UnCalificado - Diagrama de clases del dominio
skinparam classAttributeIconSize 0

abstract class Proveedor {
  +id: UUID
  +nombre: String
  +modalidad: ModalidadProveedor
  +oficios: Set<Oficio>
  +cobertura: Set<Zona>
  +experienciaAnios: Integer
  +disponibilidad: Disponibilidad
}

class TrabajadorIndependiente {
  +foto: Archivo?
}

class OrganizacionContratistas {
  +representante: String
  +nombreLegal: String
}

class Usuario {
  +id: UUID
  +email: String
  +rol: Rol
  +estado: EstadoCuenta
  +consentimientoVigente: String
}

class Solicitud {
  +id: UUID
  +estado: EstadoProyecto
  +resultadoEsperado: String
  +oficio: Oficio?
  +zonaAproximada: Zona
  +fechaDeseada: Date?
  +descripcion: String
  +confirmadaEn: DateTime?
}

class Archivo {
  +id: UUID
  +tipo: TipoArchivo
  +objectKey: String
  +mimeType: String
  +tamanoBytes: Integer
  +propietarioId: UUID
}

class Cita {
  +id: UUID
  +estado: EstadoCita
  +inicio: DateTime
  +fin: DateTime
  +costoMxn: Decimal
  +esVisita: Boolean
}

class Propuesta {
  +id: UUID
  +version: Integer
  +estado: EstadoPropuesta
  +totalMxn: Decimal
  +emitidaEn: DateTime
  +expiraEn: DateTime
}

class Cambio {
  +id: UUID
  +tipo: TipoCambio
  +estado: EstadoCambio
  +motivo: String
  +diferenciaMxn: Decimal
  +expiraEn: DateTime
}

class VersionPresupuesto {
  +numero: Integer
  +totalMxn: Decimal
  +diferenciaDesdeInicialMxn: Decimal
  +creadaEn: DateTime
}

class Mensaje {
  +id: UUID
  +contenido: String
  +enviadoEn: DateTime
}

class Evaluacion {
  +id: UUID
  +puntualidad: Integer
  +calidad: Integer
  +limpieza: Integer
  +apegoPresupuesto: Integer
  +comentario: String?
  +estado: EstadoPublicacion
}

class Verificacion {
  +id: UUID
  +tipo: TipoVerificacion
  +estado: EstadoVerificacion
  +motivo: String?
  +revisadaEn: DateTime?
}

class Disponibilidad {
  +id: UUID
  +estadoGeneral: EstadoDisponibilidad
  +franjas: Set<Franja>
}

class BitacoraEvento {
  +id: UUID
  +accion: String
  +actorId: UUID
  +ocurridoEn: DateTime
  +eventoAnteriorId: UUID?
}

enum Rol {
  CLIENTE
  PROVEEDOR
  ADMINISTRADOR
}

enum ModalidadProveedor {
  TRABAJADOR
  ORGANIZACION
}

enum EstadoProyecto {
  BORRADOR
  CONFIRMADA
  PROGRAMADO
  EN_PROCESO
  TERMINADO
  CONCLUIDO
}

Usuario "1" -- "0..1" Proveedor : cuenta de proveedor
Proveedor <|-- TrabajadorIndependiente
Proveedor <|-- OrganizacionContratistas
Proveedor "1" *-- "1" Disponibilidad
Proveedor "1" *-- "0..*" Verificacion
Usuario "1" -- "0..*" Solicitud : propietario
Proveedor "0..1" -- "0..*" Solicitud : seleccionado
Solicitud "1" *-- "0..*" Archivo
Solicitud "1" *-- "0..*" Cita
Solicitud "1" *-- "0..*" Propuesta
Solicitud "1" *-- "0..*" Cambio
Solicitud "1" *-- "0..*" Mensaje
Solicitud "1" *-- "0..*" BitacoraEvento
Propuesta "1" *-- "1..*" VersionPresupuesto
Cambio "0..*" -- "0..*" VersionPresupuesto : genera al aprobar
Usuario "1" -- "0..*" Mensaje : emisor
Usuario "1" -- "0..*" Evaluacion : autor
Solicitud "1" -- "0..*" Evaluacion : proyecto
Proveedor "1" -- "0..*" Evaluacion : sujeto
Usuario ..> Rol : usa
Proveedor ..> ModalidadProveedor : usa
Solicitud ..> EstadoProyecto : usa

note right of Archivo
  Composición lógica con Solicitud:
  metadata y permisos en PostgreSQL.
  El binario vive en object storage.
end note

note bottom of BitacoraEvento
  Append-only: las decisiones no se
  modifican sin un evento posterior.
end note
@enduml
