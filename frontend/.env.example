# Copia este archivo como .env.local y ajusta los valores si es necesario.
# No guardes secretos aquí: toda variable VITE_* queda incluida en el código que descarga el navegador.

# Prefijo base de la API que usa el cliente HTTP (src/services/httpClient.ts).
# Con "/api", las peticiones pasan por el proxy de desarrollo de Vite (vite.config.ts).
VITE_API_URL=/api

# Destino del proxy de desarrollo (solo lo lee vite.config.ts; no llega al navegador).
# Backend Flask de la rama feature/s05-s06-a2-auth (run.py usa el puerto 5000 por defecto).
BACKEND_PROXY_TARGET=http://localhost:5000
